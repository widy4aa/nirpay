generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  username         String?   @unique
  fullName         String    @map("full_name")
  phoneNumber      String?   @unique @map("phone_number")
  passwordHash     String    @map("password_hash")
  pinHash          String    @map("pin_hash")
  publicKeyB64     String?   @map("public_key_b64")
  role             String    @default("USER")
  isKycDone        Boolean   @default(false) @map("is_kyc_done")
  kycStatus        String    @default("UNVERIFIED") @map("kyc_status")
  kycFaceUrl       String?   @map("kyc_face_url")
  kycSubmittedAt   DateTime? @map("kyc_submitted_at")
  kycReviewedAt    DateTime? @map("kyc_reviewed_at")
  kycRejectReason  String?   @map("kyc_reject_reason")
  gender           String?
  birthDate        DateTime? @map("birth_date")
  isActive         Boolean   @default(true) @map("is_active")
  isLocked         Boolean   @default(false) @map("is_locked")
  lockedReason     String?   @map("locked_reason")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lastLoginAt      DateTime? @map("last_login_at")
  lastLoginIp      String?   @map("last_login_ip")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  wallet           WalletBalance?
  sessions         DeviceSession[]
  auditLogs        AuditLog[]

  @@map("users")
}

model WalletBalance {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  amountCent     BigInt   @default(0) @map("amount_cent")
  reservedCent   BigInt   @default(0) @map("reserved_cent")
  currency       String   @default("IDR")
  maxHop         Int      @default(3) @map("max_hop")
  totalMinted    BigInt   @default(0) @map("total_minted")
  totalSent      BigInt   @default(0) @map("total_sent")
  totalReceived  BigInt   @default(0) @map("total_received")
  lastTxAt       DateTime? @map("last_tx_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_balances")
}

model DeviceSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  deviceId     String?   @map("device_id")
  deviceName   String?   @map("device_name")
  ipAddress    String?   @map("ip_address")
  authToken    String    @map("auth_token")
  refreshToken String?   @map("refresh_token")
  isRevoked    Boolean   @default(false) @map("is_revoked")
  expiresAt    DateTime  @map("expires_at")
  lastActiveAt DateTime? @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_sessions")
}

model OtpVerification {
  id           String   @id @default(uuid())
  email        String
  otpHash      String   @map("otp_hash")
  channel      String
  purpose      String
  attemptCount Int      @default(0) @map("attempt_count")
  maxAttempts  Int      @default(5) @map("max_attempts")
  isUsed       Boolean  @default(false) @map("is_used")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("otp_verifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  actorRole    String?  @map("actor_role")
  eventType    String   @map("event_type")
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  detail       Json?
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
