# ─── NirPay Docker Environment ───

# Database
DB_USERNAME=nirpay
DB_PASSWORD=nirpay123
DB_DATABASE=nirpay
DB_PORT=5432

# Backend (Laravel)
BACKEND_PORT=3001
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
JWT_SECRET=nirpay-jwt-secret-change-me
JWT_TTL=15
JWT_REFRESH_TTL=43200

# Dashboard (Next.js)
DASHBOARD_PORT=3000
NEXTAUTH_SECRET=nirpay-dashboard-secret-change-me

# FCM (optional, for push notifications)
FCM_SERVER_KEY=

# Log level
LOG_LEVEL=info
